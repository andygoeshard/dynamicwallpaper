    <!-- Background location disclosure -->
    <string name="bg_location_disclosure_title">Let Iris access your location in the background?</string>
    <string name="bg_location_disclosure_body">To keep your wallpaper in sync with your surroundings, Iris needs to access your approximate location from time to time, even when the app is not open.</string>
    <string name="bg_location_disclosure_what">What is accessed</string>
    <string name="bg_location_disclosure_what_desc">Your approximate location, checked periodically in the background. It is sent to our weather provider (Open-Meteo) to fetch local conditions. It is never used for advertising or sold to anyone.</string>
    <string name="bg_location_disclosure_why">Why</string>
    <string name="bg_location_disclosure_why_desc">To automatically update your wallpaper based on your local weather and the geofences you set up.</string>
    <string name="bg_location_disclosure_how">How to turn it off</string>
    <string name="bg_location_disclosure_how_desc">You can disable it anytime: turn off \"Use GPS\" in Iris settings, or revoke the location permission in your device settings.</string>
